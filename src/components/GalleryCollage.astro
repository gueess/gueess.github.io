---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type LayoutBlock =
  CollectionEntry<"galleries">["data"]["composition"]["blocks"][number];
type GalleryPhoto =
  CollectionEntry<"galleries">["data"]["composition"]["photos"][number];

interface Props {
  block: LayoutBlock;
  photos: GalleryPhoto[];
  startIndex: number;
}

const { block, photos, startIndex } = Astro.props;
const placements = {
  roof: [
    [2, 7, 36],
    [41, 0, 37],
    [76, 2, 20],
    [4, 43, 20],
    [33, 53, 32],
    [68, 55, 30],
  ],
  markers: [
    [0, 0, 22],
    [37, 0, 22],
    [74, 0, 22],
    [0, 40, 20],
    [30, 37, 34],
    [71, 39, 20],
    [31, 70, 35],
  ],
  "shanxi-eaves": [
    [12, 4, 13],
    [36, 10, 19],
    [60, 6, 16],
    [8, 36, 23],
    [38, 36, 22],
    [64, 32, 12],
    [10, 62, 13],
    [35, 58, 20],
    [63, 65, 12],
    [36, 76, 18],
  ],
  "shanxi-hall": [
    [14, 3, 26],
    [46, 3, 25],
    [17, 28, 18],
    [51, 27, 18],
    [13, 55, 22],
    [50, 53, 18],
    [14, 76, 18],
    [49, 78, 27],
  ],
  "shanxi-thresholds": [
    [17, 2, 22],
    [70, 1, 15],
    [43, 14, 22],
    [20, 33, 17],
    [43, 37, 24],
    [65, 36, 23],
    [20, 57, 16],
    [44, 62, 22],
    [70, 58, 15],
    [28, 78, 15],
    [60, 75, 20],
  ],
  "shanxi-grottoes": [
    [15, 7, 18],
    [55, 5, 17],
    [32, 34, 30],
    [17, 58, 27],
    [52, 60, 28],
  ],
  "shanxi-passage": [
    [21, 2, 18],
    [55, 0, 17],
    [20, 19, 19],
    [57, 21, 15],
    [17, 38, 19],
    [53, 41, 25],
    [20, 54, 16],
    [57, 56, 15],
    [18, 69, 19],
    [51, 72, 24],
    [14, 83, 20],
    [54, 85, 25],
    [16, 100, 23],
    [52, 103, 25],
  ],
} as const;
const style = block.collageStyle;
const positions = placements[style];
---

<section class={`gallery-collage gallery-collage--${style}`}>
  {
    photos.map((photo, index) => {
      const [x, y, width] = positions[index] ?? [0, index * 12, 30];
      return (
        <figure
          class="gallery-photo"
          style={`--collage-x: ${x}%; --collage-y: ${y}%; --collage-width: ${width}%;`}
        >
          <button
            class="gallery-photo__button"
            type="button"
            data-lightbox-trigger
            data-lightbox-index={startIndex + index}
            aria-label={`查看大图：${photo.alt}`}
          >
            <Picture
              src={photo.image}
              widths={[480, 720, 960, 1280]}
              sizes="(max-width: 760px) 48vw, 34vw"
              formats={["webp"]}
              alt={photo.alt}
              loading="lazy"
            />
          </button>
          <figcaption aria-hidden="true"></figcaption>
        </figure>
      );
    })
  }
</section>

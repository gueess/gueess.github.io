---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type LayoutBlock =
  CollectionEntry<"galleries">["data"]["composition"]["blocks"][number];
type GalleryPhoto =
  CollectionEntry<"galleries">["data"]["composition"]["photos"][number];

interface Props {
  block: LayoutBlock;
  photos: GalleryPhoto[];
  startIndex: number;
}

const { block, photos, startIndex } = Astro.props;
const placements = {
  roof: [
    [2, 7, 36],
    [41, 0, 37],
    [76, 2, 20],
    [4, 43, 20],
    [33, 53, 32],
    [68, 55, 30],
  ],
  markers: [
    [0, 0, 22],
    [37, 0, 22],
    [74, 0, 22],
    [0, 40, 20],
    [30, 37, 34],
    [71, 39, 20],
    [31, 70, 35],
  ],
  "shanxi-eaves": [
    [16, 5, 12],
    [36, 10, 17.5],
    [59, 6, 15.5],
    [13, 36, 17],
    [38.5, 37, 17],
    [63, 32, 11.5],
    [15, 62, 11.5],
    [35, 58, 17],
    [60.5, 65, 11.5],
    [36, 76, 17],
  ],
  "shanxi-hall": [
    [14, 3, 26],
    [46, 3, 25],
    [17, 28, 18],
    [51, 27, 18],
    [13, 55, 22],
    [50, 53, 18],
    [14, 76, 18],
    [49, 78, 27],
  ],
  "shanxi-thresholds": [
    [17, 2, 22],
    [70, 1, 15],
    [43, 14, 22],
    [20, 33, 17],
    [43, 37, 24],
    [65, 36, 23],
    [20, 57, 16],
    [44, 62, 22],
    [70, 58, 15],
    [28, 78, 15],
    [60, 75, 20],
  ],
  "shanxi-grottoes": [
    [15, 7, 18],
    [55, 5, 17],
    [32, 34, 30],
    [17, 58, 27],
    [52, 60, 28],
  ],
  "shanxi-passage": [
    [21, 2, 18],
    [55, 0, 17],
    [20, 19, 19],
    [57, 21, 15],
    [17, 38, 19],
    [53, 41, 25],
    [20, 54, 16],
    [57, 56, 15],
    [18, 69, 19],
    [51, 72, 24],
    [14, 83, 20],
    [54, 85, 25],
    [16, 100, 23],
    [52, 103, 25],
  ],
  "shanxi-eaves-full": [
    [6, 3.2, 22], [36, 4.8, 30], [72, 0.8, 22],
    [0, 31.2, 31], [35, 28.8, 31], [76, 27.2, 20],
    [6, 54.4, 22], [36, 51.2, 30], [76, 52.8, 20], [36, 80.8, 30],
  ],
  "shanxi-hall-full": [
    [10, 2.1, 36], [54, 2.1, 36], [12, 21, 28], [54, 20.3, 28],
    [8, 41.3, 36], [54, 39.9, 28], [12, 62.3, 28], [48, 67.2, 40],
  ],
  "shanxi-thresholds-full": [
    [6, 1.8, 35], [38, 7.2, 35], [76, 0, 20],
    [8, 23.4, 24], [38, 25.2, 32], [72, 23.4, 26],
    [8, 45, 23], [38, 48.6, 32], [76, 44.4, 20],
    [24, 65.4, 20], [55, 64.2, 29],
  ],
  "shanxi-grottoes-full": [
    [15, 3.4, 28], [57, 2.6, 27], [32, 34, 35], [7, 57, 42], [53, 57, 42],
  ],
  "shanxi-passage-full": [
    [10, 0.9, 27], [55, 0.9, 27], [10, 14.3, 27], [58, 14.3, 25],
    [10, 27.6, 25], [45, 29.4, 45], [10, 40.5, 25], [58, 41.9, 23],
    [10, 53.8, 28], [48, 56.1, 42], [10, 68.1, 32], [53, 70.4, 40],
    [10, 81.9, 38], [55, 83.3, 40],
  ],
} as const;
const style = block.collageStyle;
const positions = placements[style];
---

<section class={`gallery-collage gallery-collage--${style}`}>
  {
    photos.map((photo, index) => {
      const [x, y, width] = positions[index] ?? [0, index * 12, 30];
      return (
        <figure
          class="gallery-photo"
          style={`--collage-x: ${x}%; --collage-y: ${y}%; --collage-width: ${width}%;`}
        >
          <button
            class="gallery-photo__button"
            type="button"
            data-lightbox-trigger
            data-lightbox-index={startIndex + index}
            aria-label={`查看大图：${photo.alt}`}
          >
            <Picture
              src={photo.image}
              widths={[480, 720, 960, 1280]}
              sizes="(max-width: 760px) 48vw, 34vw"
              formats={["webp"]}
              alt={photo.alt}
              loading="eager"
              fetchpriority={index === 0 ? "high" : "auto"}
            />
          </button>
          <figcaption>
            <span>{String(startIndex + index + 1).padStart(2, "0")}</span>
            {photo.caption && <span>{photo.caption}</span>}
          </figcaption>
        </figure>
      );
    })
  }
</section>

---
import SiteHeader from "../components/SiteHeader.astro";
import { getSiteSettings } from "../lib/content";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  showHeader?: boolean;
  quietHeader?: boolean;
}

const settings = await getSiteSettings();
const {
  title,
  description = settings.introduction,
  noindex = false,
  showHeader = true,
  quietHeader = false,
} = Astro.props;
const pageTitle = title ? `${title} — Joe Photographs` : settings.siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/og-photographs.png", Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f3f0e9" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content="长江与桥梁的蓝调时刻，JOE / PHOTOGRAPHS" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    {showHeader && <SiteHeader quiet={quietHeader} />}
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
